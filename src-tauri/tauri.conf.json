{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrightPause",
  "version": "0.3.0",
  "identifier": "io.github.jordanalbayrak.brightpause",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5Mzk4NThFMzRBMTIyOEIKUldTTElxRTBqb1U1ZWRtaFZaR2xTNlY0V0xLSUNJcHprOGxESVQ3NHZmbXNRMHBjWWJiU2J1RFQK",
      "endpoints": ["https://github.com/JordanAlbayrak/BrightPause/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "copyright": "Copyright (c) 2026 Jordan Albayrak",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "uninstallerHeaderImage": "windows/header.bmp"
      }
    }
  }
}
